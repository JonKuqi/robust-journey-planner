        <mxCell id="inf_load" parent="inf_bg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" value="&lt;b&gt;DelayModel.load()&lt;/b&gt;&lt;br&gt;at planner.prepare()&lt;br&gt;Loads all 7 boosters + metadata&lt;br&gt;+ hist_aggs + clim_weather&lt;br&gt;+ stop_station_mapping&lt;br&gt;+ stop_canton_mapping&lt;br&gt;+ precomputed_delays (once)" vertex="1">
